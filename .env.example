# LEASH Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Application
APP_NAME=LEASH
APP_VERSION=0.1.0
DEBUG=false

# Database
DATABASE_URL=sqlite:///./leash.db

# CORS — JSON array of allowed origins (comma-separated strings also supported)
CORS_ORIGINS=["http://localhost:5173"]

# PayPal (Phase 2+)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# Gemini AI (Phase 2+)
# GEMINI_API_KEY=
