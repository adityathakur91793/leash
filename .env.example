# LEASH Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Application
APP_NAME=LEASH
APP_VERSION=0.2.0-dev
DEBUG=false

# Database
DATABASE_URL=sqlite:///./leash.db

# CORS — JSON array of allowed origins (comma-separated strings also supported)
CORS_ORIGINS=["http://localhost:5173"]

# Mandate Security (Phase 2A)
# Required. Secret used for server-side HMAC-SHA256 mandate signing (min 32 bytes).
# Replace this placeholder before running the backend.
MANDATE_SIGNING_KEY=replace-with-a-random-secret-at-least-32B!

# PayPal (Phase 2+)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# Gemini AI (Phase 2+)
# GEMINI_API_KEY=
